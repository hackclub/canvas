# Hack Club Auth
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# Hackatime
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
HACKATIME_API=

# Postgres (docker compose)
POSTGRES_USER=canvas
POSTGRES_PASSWORD=
POSTGRES_DB=canvas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://canvas:<password>@localhost:5432/canvas

# Encrypts the session cookie (nuxt-auth-utils)
NUXT_SESSION_PASSWORD=

# Encrypts the Hack Club Auth and Hackatime tokens stored in the database
TOKEN_ENCRYPTION_KEY=

# Public origin of the site, e.g. https://canvas.hackclub.com
SITE_URL=http://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
CLOUDFLARE_API_TOKEN=

# Set to true to close ship submissions and turn off the double pixels deal (banner and DMs)
SHIPS_CLOSED=false
# Set to true to stop anyone from placing pixels on the canvas
CANVAS_CLOSED=false

# Slack bot token. Scopes: users:read, chat:write (DMs), channels:manage (adding to SLACK_CHANNEL_ID).
# DMs are only sent in production, and need SITE_URL for their links.
SLACK_XOXB=xoxb-
# Channel ID (e.g. C0123456789) new users are added to when they first sign up, and pointed to
# in the welcome DM. Leave empty to skip.
SLACK_CHANNEL_ID=
